# Keep this ID distinct when several ROS 2 systems share a network.
ROS_DOMAIN_ID=42

# Docker Compose is the macOS test environment and uses mac_test.launch.py.
# Native Ubuntu/Raspberry Pi uses hardware.launch.py instead of this file.

# Voice companion. Copy to .env and fill in; never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
COMPANION_SPEECH_SPEED=1.15

# Guardian Voice (companion/guardian/specs.md). Enabled when the agent ID is set.
ELEVENLABS_AGENT_ID=
# "fake" prints texts instead of sending them; "twilio" sends them (needs the
# TWILIO_* values and GUARDIAN_CONTACT_NUMBER); unset disables texting.
GUARDIAN_SMS=fake
GUARDIAN_CONTACT_NAME=
GUARDIAN_CONTACT_NUMBER=
GUARDIAN_USER_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Laptop demo launcher (scripts/laptop_launch.py).
PI_LAN_IP=
PI_SSH_USER=raspi
